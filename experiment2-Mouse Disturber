// Experiment 2 — Mouse Disturber
//
// Starting point: p5.js Forces example from p5js.org/examples/math-and-physics-forces/
// Source: Processing Foundation, licensed CC BY-NC-SA 4.0
// The Particle class structure and basic force application loop came from that example.
// The three force behaviours, HSB colour system, trail effect, and variation
// switching are all my own development from that starting point.
//
// Also referenced Craig Reynolds' Boids (1987) for the alignment concept in flock mode.
// red3d.com/cwr/boids/
//
// HOW VARIATIONS WORK:
// Click anywhere on the canvas to cycle through the three variations.
// Variation 1 — Repel & Shatter
// Variation 2 — Orbital Gravity
// Variation 3 — Magnetic Flock

let particles = [];
let mode = 0;

function setup() {
  createCanvas(400, 400);
  colorMode(HSB, 360, 100, 100, 100);
  spawnParticles();
}

function spawnParticles() {
  particles = [];
  for (let i = 0; i < 220; i++) {
    particles.push(new Particle(i));
  }
}

function draw() {
  // low alpha clear creates motion trails — unplanned but kept it
  background(240, 20, 8, 18);
  for (let p of particles) {
    p.update(mouseX, mouseY);
    p.draw();
  }
}

class Particle {
  constructor(index) {
    this.index = index;
    this.hue = map(index, 0, 220, 180, 300);

    let cols = floor(sqrt(220) * 1.4);
    this.hx = map(index % cols, 0, cols - 1, width * 0.1, width * 0.9);
    this.hy = map(floor(index / cols), 0, ceil(220 / cols) - 1, height * 0.15, height * 0.85);

    this.x = this.hx;
    this.y = this.hy;
    this.vx = 0;
    this.vy = 0;
    this.size = random(3, 7);
  }

  update(mx, my) {
    let dx = this.x - mx;
    let dy = this.y - my;
    let d = sqrt(dx * dx + dy * dy);
    let inRange = d < 160 && d > 1;

    if (mode === 0) this.repel(dx, dy, d, inRange);
    else if (mode === 1) this.orbit(dx, dy, d, inRange);
    else this.flock(dx, dy, d, inRange);
  }

  // Variation 1 — Repel & Shatter
  // Squared falloff: close particles burst hard, far ones barely move.
  // Spring constant 0.04 returns them home in ~1.5 seconds without oscillating.
  repel(dx, dy, d, inRange) {
    if (inRange) {
      let f = pow(1 - d / 160, 2) * 14;
      this.vx += (dx / d) * f;
      this.vy += (dy / d) * f;
    }
    this.vx += (this.hx - this.x) * 0.04;
    this.vy += (this.hy - this.y) * 0.04;
    this.vx *= 0.82;
    this.vy *= 0.82;
    this.x += this.vx;
    this.y += this.vy;
  }

  // Variation 2 — Orbital Gravity
  // Inward pull + perpendicular tangential nudge = swirling orbit.
  // 0.6 tangential multiplier took a lot of tuning —
  // higher = particles escape, lower = they pile up at the cursor.
  orbit(dx, dy, d, inRange) {
    if (inRange) {
      let pull = (1 - d / 160) * 3.5;
      this.vx -= (dx / d) * pull;
      this.vy -= (dy / d) * pull;
      this.vx += (-dy / d) * pull * 0.6;
      this.vy += (dx / d) * pull * 0.6;
    }
    this.vx += (this.hx - this.x) * 0.008;
    this.vy += (this.hy - this.y) * 0.008;
    this.vx *= 0.93;
    this.vy *= 0.93;
    this.x += this.vx;
    this.y += this.vy;
  }

  // Variation 3 — Magnetic Flock
  // Particles align to a flow direction from mouse + evolving sine wave.
  // Per-particle phase offset (index * 0.04) means each one is slightly
  // out of sync — the group has internal variation and looks alive.
  flock(dx, dy, d, inRange) {
    if (inRange) {
      let t = frameCount * 0.015 + this.index * 0.04;
      let flowAngle = atan2(dy, dx) + HALF_PI + sin(t) * 0.8;
      let strength = (1 - d / 160) * 3.2;
      this.vx += cos(flowAngle) * strength;
      this.vy += sin(flowAngle) * strength;
    }
    this.vx += (this.hx - this.x) * 0.015;
    this.vy += (this.hy - this.y) * 0.015;
    this.vx *= 0.88;
    this.vy *= 0.88;
    this.x += this.vx;
    this.y += this.vy;
  }

  draw() {
    let speed = sqrt(this.vx * this.vx + this.vy * this.vy);
    noStroke();
    fill(this.hue, map(speed, 0, 10, 30, 90), map(speed, 0, 10, 55, 100), map(speed, 0, 6, 70, 100));
    ellipse(this.x, this.y, this.size + speed * 0.4);

    if (speed > 3) {
      stroke(this.hue, 60, 90, 40);
      strokeWeight(1);
      line(this.x, this.y, this.x - this.vx * 2.5, this.y - this.vy * 2.5);
      noStroke();
    }
  }
}

// click anywhere to cycle to the next variation and reset particles
function mousePressed() {
  mode = (mode + 1) % 3;
  spawnParticles();
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
  spawnParticles();
}