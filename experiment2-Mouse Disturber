// Experiment 2 — Mouse Disturber
// Inspired by Daniel Shiffman's Nature of Code (Ch.2 Forces) and the in-class particle demo (week 5)
// Also took the flock mode idea loosely from Craig Reynolds' Boids rules (red3d.com/cwr/boids)
// I built on the basic particle loop from class and wrote three completely different
// force behaviours from scratch — the hardest part was tuning orbit so particles don't fly off screen.

let particles = [];
let mode = 0;
let btn1, btn2, btn3;

function setup() {
  createCanvas(windowWidth, windowHeight);
  colorMode(HSB, 360, 100, 100, 100);
  spawnParticles();

  btn1 = createButton('Variation 1 — Repel');
  btn2 = createButton('Variation 2 — Orbit');
  btn3 = createButton('Variation 3 — Flock');

  styleBtn(btn1);
  styleBtn(btn2);
  styleBtn(btn3);

  btn1.position(20, 20);
  btn2.position(20, 55);
  btn3.position(20, 90);

  btn1.mousePressed(() => { mode = 0; spawnParticles(); });
  btn2.mousePressed(() => { mode = 1; spawnParticles(); });
  btn3.mousePressed(() => { mode = 2; spawnParticles(); });
}

function styleBtn(btn) {
  btn.style('background', 'rgba(255,255,255,0.08)');
  btn.style('color', 'rgba(255,255,255,0.75)');
  btn.style('border', '1px solid rgba(255,255,255,0.2)');
  btn.style('padding', '6px 14px');
  btn.style('font-family', 'monospace');
  btn.style('font-size', '12px');
  btn.style('cursor', 'pointer');
  btn.style('border-radius', '3px');
}

function spawnParticles() {
  particles = [];
  for (let i = 0; i < 220; i++) {
    particles.push(new Particle(i));
  }
}

function draw() {
  // low alpha on background each frame = motion trails, didn't plan this but loved the effect
  background(240, 20, 8, 18);
  for (let p of particles) {
    p.update(mouseX, mouseY);
    p.draw();
  }
}

class Particle {
  constructor(index) {
    this.index = index;
    this.hue = map(index, 0, 220, 180, 300);

    let cols = floor(sqrt(220) * 1.4);
    this.hx = map(index % cols, 0, cols - 1, width * 0.1, width * 0.9);
    this.hy = map(floor(index / cols), 0, ceil(220 / cols) - 1, height * 0.15, height * 0.85);

    this.x = this.hx;
    this.y = this.hy;
    this.vx = 0;
    this.vy = 0;
    this.size = random(3, 7);
  }

  update(mx, my) {
    let dx = this.x - mx;
    let dy = this.y - my;
    let d = sqrt(dx * dx + dy * dy);
    let inRange = d < 160 && d > 1;

    if (mode === 0) this.repel(dx, dy, d, inRange);
    else if (mode === 1) this.orbit(dx, dy, d, inRange);
    else this.flock(dx, dy, d, inRange);
  }

  // Squared falloff means close particles burst outward hard, far ones barely move.
  // Spring constant 0.04 gets them home in about 1.5 seconds without oscillating too much.
  repel(dx, dy, d, inRange) {
    if (inRange) {
      let f = pow(1 - d / 160, 2) * 14;
      this.vx += (dx / d) * f;
      this.vy += (dy / d) * f;
    }
    this.vx += (this.hx - this.x) * 0.04;
    this.vy += (this.hy - this.y) * 0.04;
    this.vx *= 0.82;
    this.vy *= 0.82;
    this.x += this.vx;
    this.y += this.vy;
  }

  // Pull toward cursor + a sideways nudge perpendicular to the pull = orbit.
  // The 0.6 multiplier on the tangential part took a lot of trial and error —
  // higher and they escape, lower and they just pile up at the cursor.
  orbit(dx, dy, d, inRange) {
    if (inRange) {
      let pull = (1 - d / 160) * 3.5;
      this.vx -= (dx / d) * pull;
      this.vy -= (dy / d) * pull;
      this.vx += (-dy / d) * pull * 0.6;
      this.vy += (dx / d) * pull * 0.6;
    }
    this.vx += (this.hx - this.x) * 0.008;
    this.vy += (this.hy - this.y) * 0.008;
    this.vx *= 0.93;
    this.vy *= 0.93;
    this.x += this.vx;
    this.y += this.vy;
  }

  // Each particle aligns to a flow angle based on mouse direction + a sine wave.
  // The index offset (index * 0.04) gives each one a slightly different phase
  // so they don't all move in sync — makes it look more alive.
  flock(dx, dy, d, inRange) {
    if (inRange) {
      let t = frameCount * 0.015 + this.index * 0.04;
      let flowAngle = atan2(dy, dx) + HALF_PI + sin(t) * 0.8;
      let strength = (1 - d / 160) * 3.2;
      this.vx += cos(flowAngle) * strength;
      this.vy += sin(flowAngle) * strength;
    }
    this.vx += (this.hx - this.x) * 0.015;
    this.vy += (this.hy - this.y) * 0.015;
    this.vx *= 0.88;
    this.vy *= 0.88;
    this.x += this.vx;
    this.y += this.vy;
  }

  draw() {
    let speed = sqrt(this.vx * this.vx + this.vy * this.vy);
    noStroke();
    fill(this.hue, map(speed, 0, 10, 30, 90), map(speed, 0, 10, 55, 100), map(speed, 0, 6, 70, 100));
    ellipse(this.x, this.y, this.size + speed * 0.4);

    if (speed > 3) {
      stroke(this.hue, 60, 90, 40);
      strokeWeight(1);
      line(this.x, this.y, this.x - this.vx * 2.5, this.y - this.vy * 2.5);
      noStroke();
    }
  }
}

function keyPressed() {
  if (key === "1") { mode = 0; spawnParticles(); }
  if (key === "2") { mode = 1; spawnParticles(); }
  if (key === "3") { mode = 2; spawnParticles(); }
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
  spawnParticles();
  btn1.position(20, 20);
  btn2.position(20, 55);
  btn3.position(20, 90);
}