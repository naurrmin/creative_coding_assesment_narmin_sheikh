// Experiment 1 — Moiré Interference
//
// Starting point: p5.js basic line example from the official p5.js examples page
// https://p5js.org/examples/form-lines/
// That example just draws a single line between two points.
// From there I built the idea of repeating that into a radial system,
// then layering two systems on top of each other to get the interference.
//
// Also inspired by Nervous System studio (n-e-r-v-o-u-s.com) who use
// interference patterns in their generative jewellery and fabric work.
//
// The dual-system idea, noise alpha, mouse offset, and all three variations
// are my own development from that starting point.

let mode = 0;
let t = 0;
let btn1, btn2, btn3;

function setup() {
  createCanvas(windowWidth, windowHeight);
  strokeWeight(0.8);
  noFill();

  // create three buttons to switch variations
  btn1 = createButton('Variation 1 — Radial');
  btn2 = createButton('Variation 2 — Linear');
  btn3 = createButton('Variation 3 — Spiral');

  styleBtn(btn1);
  styleBtn(btn2);
  styleBtn(btn3);

  // position them top left
  btn1.position(20, 20);
  btn2.position(20, 55);
  btn3.position(20, 90);

  btn1.mousePressed(() => mode = 0);
  btn2.mousePressed(() => mode = 1);
  btn3.mousePressed(() => mode = 2);
}

function styleBtn(btn) {
  btn.style('background', 'rgba(255,255,255,0.08)');
  btn.style('color', 'rgba(255,255,255,0.75)');
  btn.style('border', '1px solid rgba(255,255,255,0.2)');
  btn.style('padding', '6px 14px');
  btn.style('font-family', 'monospace');
  btn.style('font-size', '12px');
  btn.style('cursor', 'pointer');
  btn.style('border-radius', '3px');
}

function draw() {
  background(10, 10, 18);
  t += 0.004;

  let mx = (mouseX / width - 0.5) * 2;
  let my = (mouseY / height - 0.5) * 2;

  if (mode === 0) drawRadial(mx, my);
  else if (mode === 1) drawLinear(mx, my);
  else drawSpiral(mx, my);
}

// Variation 1 — Radial
// Two sets of radial lines from drifting centres.
// Mouse pushes them in opposite directions which
// stretches or collapses the interference zone.
function drawRadial(mx, my) {
  let cx1 = width / 2 + mx * 80 + sin(t * 0.7) * 60;
  let cy1 = height / 2 + my * 60 + cos(t * 0.5) * 40;
  let cx2 = width / 2 - mx * 80 + cos(t * 0.9) * 70;
  let cy2 = height / 2 - my * 60 + sin(t * 0.6) * 50;

  for (let i = 0; i < 120; i++) {
    let angle = (TWO_PI / 120) * i;
    let len = max(width, height) * 0.8;

    stroke(255, 255, 255, map(noise(i * 0.1, t * 0.3), 0, 1, 0.15, 0.9) * 180);
    line(cx1, cy1, cx1 + cos(angle) * len, cy1 + sin(angle) * len);

    let a2 = angle + t * 0.12 + mx * 0.3;
    stroke(200, 220, 255, map(noise(i * 0.1 + 100, t * 0.3 + 10), 0, 1, 0.15, 0.9) * 150);
    line(cx2, cy2, cx2 + cos(a2) * len, cy2 + sin(a2) * len);
  }
}

// Variation 2 — Linear Wave
// Horizontal and vertical sine-wave grids layered together.
// Different frequencies mean they never line up — creates the shimmer.
function drawLinear(mx, my) {
  let spacing = 14;

  for (let i = 0; i < floor(height / spacing) + 2; i++) {
    let y = i * spacing;
    stroke(255, 255, 255, map(sin(i * 0.3 + t * 1.2 + mx * 2), -1, 1, 40, 220));
    beginShape();
    for (let x = 0; x <= width; x += 4) {
      vertex(x, y + sin(x * 0.015 + t * 1.5 + my * 2) * 18);
    }
    endShape();
  }

  for (let i = 0; i < floor(width / spacing) + 2; i++) {
    let x = i * spacing;
    stroke(180, 200, 255, map(cos(i * 0.3 + t * 0.9 + my * 2), -1, 1, 30, 180));
    beginShape();
    for (let y = 0; y <= height; y += 4) {
      vertex(x + cos(y * 0.015 + t * 1.1 + mx * 2) * 18, y);
    }
    endShape();
  }
}

// Variation 3 — Spiral Vortex
// Two sets of 5-arm spirals counter-rotating.
// Mouse squishes the Y axis of the second set, warping the vortex.
function drawSpiral(mx, my) {
  let cx = width / 2 + mx * 50;
  let cy = height / 2 + my * 50;
  let maxR = max(width, height) * 0.6;

  for (let a = 0; a < 5; a++) {
    let offset = (TWO_PI / 5) * a;

    beginShape();
    for (let i = 0; i < 300; i++) {
      let r = (i / 300) * maxR;
      stroke(255, 255, 255, map(i, 0, 300, 220, 20));
      vertex(cx + cos((i / 300) * TWO_PI * 5 + offset + t * 0.4) * r,
             cy + sin((i / 300) * TWO_PI * 5 + offset + t * 0.4) * r);
    }
    endShape();

    beginShape();
    for (let i = 0; i < 300; i++) {
      let r = (i / 300) * maxR;
      let angle = -(i / 300) * TWO_PI * 5 + offset - t * 0.5 + mx * 0.8;
      stroke(160, 200, 255, map(i, 0, 300, 180, 10));
      vertex(cx + cos(angle) * r, cy + sin(angle) * r * (1 + my * 0.3));
    }
    endShape();
  }
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
  btn1.position(20, 20);
  btn2.position(20, 55);
  btn3.position(20, 90);
}