// Experiment 1 — Moiré Interference
//
// Starting point: "Rotate" example from p5js.org/examples/transformation-rotate/
// Source: Processing Foundation, licensed CC BY-NC-SA 4.0
// The basic idea of drawing repeated lines rotating around a centre point
// came from that example. Everything else — the dual system interference,
// the three variation types, noise alpha, and mouse interaction — is my own.
//
// Also inspired by Nervous System studio (n-e-r-v-o-u-s.com) who use
// interference patterns in their generative jewellery and fabric work.
//
// HOW VARIATIONS WORK:
// Click anywhere on the canvas to cycle through the three variations.
// Variation 1 — Radial Interference
// Variation 2 — Linear Wave
// Variation 3 — Spiral Vortex

let mode = 0;
let t = 0;

function setup() {
  createCanvas(400, 400);
  strokeWeight(0.8);
  noFill();
}

function draw() {
  background(10, 10, 18);
  t += 0.004;

  let mx = (mouseX / width - 0.5) * 2;
  let my = (mouseY / height - 0.5) * 2;

  if (mode === 0) drawRadial(mx, my);
  else if (mode === 1) drawLinear(mx, my);
  else drawSpiral(mx, my);
}

// Variation 1 — Radial Interference
// Two sets of radial lines drift from separate centres.
// Moving the mouse pushes them in opposite directions which
// stretches or collapses the interference zone between them.
function drawRadial(mx, my) {
  let cx1 = width / 2 + mx * 80 + sin(t * 0.7) * 60;
  let cy1 = height / 2 + my * 60 + cos(t * 0.5) * 40;
  let cx2 = width / 2 - mx * 80 + cos(t * 0.9) * 70;
  let cy2 = height / 2 - my * 60 + sin(t * 0.6) * 50;

  for (let i = 0; i < 120; i++) {
    let angle = (TWO_PI / 120) * i;
    let len = max(width, height) * 0.8;

    // noise-driven alpha so lines aren't all the same brightness
    stroke(255, 255, 255, map(noise(i * 0.1, t * 0.3), 0, 1, 0.15, 0.9) * 180);
    line(cx1, cy1, cx1 + cos(angle) * len, cy1 + sin(angle) * len);

    // second system rotates slightly differently — this creates the fringe
    let a2 = angle + t * 0.12 + mx * 0.3;
    stroke(200, 220, 255, map(noise(i * 0.1 + 100, t * 0.3 + 10), 0, 1, 0.15, 0.9) * 150);
    line(cx2, cy2, cx2 + cos(a2) * len, cy2 + sin(a2) * len);
  }
}

// Variation 2 — Linear Wave
// Horizontal and vertical sine-wave grids layered together.
// Different frequencies mean they never line up — creates the shimmer.
// Mouse warps the wave amplitude in real time.
function drawLinear(mx, my) {
  let spacing = 14;

  for (let i = 0; i < floor(height / spacing) + 2; i++) {
    let y = i * spacing;
    stroke(255, 255, 255, map(sin(i * 0.3 + t * 1.2 + mx * 2), -1, 1, 40, 220));
    beginShape();
    for (let x = 0; x <= width; x += 4) {
      vertex(x, y + sin(x * 0.015 + t * 1.5 + my * 2) * 18);
    }
    endShape();
  }

  for (let i = 0; i < floor(width / spacing) + 2; i++) {
    let x = i * spacing;
    stroke(180, 200, 255, map(cos(i * 0.3 + t * 0.9 + my * 2), -1, 1, 30, 180));
    beginShape();
    for (let y = 0; y <= height; y += 4) {
      vertex(x + cos(y * 0.015 + t * 1.1 + mx * 2) * 18, y);
    }
    endShape();
  }
}

// Variation 3 — Spiral Vortex
// Two sets of 5-arm spirals counter-rotating against each other.
// Mouse squishes the Y axis of the second set which warps the vortex.
// Tried 3 and 7 arms too — 5 felt the most balanced visually.
function drawSpiral(mx, my) {
  let cx = width / 2 + mx * 50;
  let cy = height / 2 + my * 50;
  let maxR = max(width, height) * 0.6;

  for (let a = 0; a < 5; a++) {
    let offset = (TWO_PI / 5) * a;

    beginShape();
    for (let i = 0; i < 300; i++) {
      let r = (i / 300) * maxR;
      stroke(255, 255, 255, map(i, 0, 300, 220, 20));
      vertex(cx + cos((i / 300) * TWO_PI * 5 + offset + t * 0.4) * r,
             cy + sin((i / 300) * TWO_PI * 5 + offset + t * 0.4) * r);
    }
    endShape();

    beginShape();
    for (let i = 0; i < 300; i++) {
      let r = (i / 300) * maxR;
      let angle = -(i / 300) * TWO_PI * 5 + offset - t * 0.5 + mx * 0.8;
      stroke(160, 200, 255, map(i, 0, 300, 180, 10));
      vertex(cx + cos(angle) * r, cy + sin(angle) * r * (1 + my * 0.3));
    }
    endShape();
  }
}

// click anywhere to cycle to the next variation
function mousePressed() {
  mode = (mode + 1) % 3;
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}